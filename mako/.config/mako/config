## Mako — dark, squared, modern
## Quiet panels; only mail (app "mailnotify") gets the accent treatment.

anchor=top-right
margin=12
width=380
padding=14,18,14,18
border-size=2
border-radius=0
max-visible=4

default-timeout=8000
ignore-timeout=0

background-color=#171a21ee
text-color=#e8eaed
border-color=#2a2f38
progress-color=#4f8cff

font=JetBrains Mono Nerd Font 10

markup=1
sort=-time
icons=1
icon-path=/usr/share/icons/hicolor/scalable/status
format=<b>%s</b>\n<span color='#8a919e'>%b</span>

[urgency=critical]
background-color=#221417ee
border-color=#ff6b6b

[app-name="mailnotify"]
border-color=#4f8cff
format=<span color='#4f8cff'>󰇮</span> <b>%s</b>\n<span color='#8a919e'>%b</span>