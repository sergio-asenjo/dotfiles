## Mako — Resend-style: near-black, hairline borders, mono type, red accent

anchor=top-right
margin=10
width=380
padding=16
border-size=1
border-radius=0
max-visible=4

default-timeout=8000
ignore-timeout=0

background-color=#0b0b0d
text-color=#f5f5f4
border-color=#262626
progress-color=#e5484d

font=JetBrains Mono Nerd Font 10

markup=1
sort=-time
icons=1
icon-path=/usr/share/icons/hicolor/scalable/status
format=<b>%s</b>\n<span color='#8a8a8a'>%b</span>

[urgency=critical]
background-color=#120c0c
border-color=#e5484d

[app-name="mailnotify"]
border-color=#e5484d
format=<span color='#e5484d'>󰇮</span> <b>%s</b>\n<span color='#8a8a8a'>%b</span>