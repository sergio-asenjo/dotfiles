## Mako — Resend dark: #111 card, white/5 hairline, no accent colors

anchor=top-right
margin=10
width=380
padding=16
border-size=1
border-radius=0
max-visible=4

default-timeout=8000
ignore-timeout=0

background-color=#111111
text-color=#ffffff
border-color=#ffffff0d
progress-color=#a1a4a5

font=JetBrains Mono Nerd Font 10

markup=1
sort=-time
icons=1
icon-path=/usr/share/icons/hicolor/scalable/status
format=<b>%s</b>\n<span color='#a1a4a5'>%b</span>

[urgency=critical]
border-color=#ffffff33

[app-name="mailnotify"]
format=<span color='#a1a4a5'>󰇮</span> <b>%s</b>\n<span color='#a1a4a5'>%b</span>